*.obj
*.o
*.exe
*.dll
*.so
*.dylib
*.lib
*.exp
*.pdb
*.ilk
*.out
build/
bin/
out/
*.ncu-rep
*.nsys-rep
*.nvvp

# Distribution / packaging
.Python
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Unit test & coverage reports
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Data directories (ignore raw & processed data files, preserve folder structure)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experiment & benchmark output runs (preserve folder structure)
results/*
!results/.gitkeep
